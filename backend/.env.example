# Application settings
APP_NAME=AI Requirement Analyzer & Prioritization System
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./requirement_analyzer.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider (optional - leave empty to use built-in NLP engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Prioritization weights (0-1 range, should sum to 1.0)
WEIGHT_BUSINESS_VALUE=0.30
WEIGHT_USER_IMPACT=0.20
WEIGHT_URGENCY=0.20
WEIGHT_EFFORT=0.15
WEIGHT_RISK=0.15
